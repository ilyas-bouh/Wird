{
  "expo": {
    "name": "Wird",
    "slug": "wird",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.wird.mobile"
    },
    "android": {
      "package": "app.wird.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#082316"
      }
    },
    "plugins": [
      "expo-audio",
      "expo-status-bar",
      "expo-asset",
      "expo-sqlite",
      "expo-font",
      "expo-navigation-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "daf9dc0b-dce9-45de-a925-0ec7a73f8f7e"
      }
    },
    "owner": "ellomaki",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}