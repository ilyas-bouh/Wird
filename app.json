{
  "expo": {
    "name": "Wird",
    "slug": "wird",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.wird.mobile"
    },
    "android": {
      "package": "app.wird.mobile"
    },
    "plugins": [
      "expo-audio",
      "expo-status-bar",
      "expo-asset",
      "expo-sqlite",
      "expo-font"
    ]
  }
}
